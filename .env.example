# Copiar este archivo a .env y ajustar los valores

# ============================================
# Microsoft Graph / Azure AD
# Credenciales del app registration que el historico_service usa
# para descargar correos y adjuntos del buzón Finagro.
# ============================================
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# ============================================
# Cron interno
# Token compartido con automation-hub para validar la llamada al
# endpoint /api/facturacion/sincronizar-cron/ desde el cron de FactIA.
# Debe coincidir con CRON_INTERNAL_TOKEN del automation-hub.
# ============================================
CRON_INTERNAL_TOKEN=

# ============================================
# Runtime
# Solo necesario fuera de docker-compose. En el service factia del compose
# central se setean explícitamente:
#   FACTIA_DATA_DIR: /data/factia
#   BACKEND_URL:     http://backend:8000
# ============================================
FACTIA_DATA_DIR=/data/factia
BACKEND_URL=http://backend:8000
